[tool.ruff]
line-length = 119

[tool.ruff.format]
quote-style = {{ "'preserve'" if skip_string_normalization else "'double'" }}

[tool.ruff.lint]
select = ["E", "W", "F", "I", "UP", "PL"]
ignore = [
    "E501", "E741", "F811"
]

[tool.ruff.lint.per-file-ignores]
"__init__.py" = ["F401"]
"__manifest__.py" = ["B018"]
